vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 64
  }
  ink: "#111827"
  muted: "#6B7280"
  accent: "#1D4ED8"
  canvas: "#FFFFFF"
  card: "#FFFFFF"
  border: "#E5E7EB"
}

# Canvas fill via a full-bleed background shape is handled in post-process.
direction: right


title: |md
  # Multi-Region Commerce Platform
  AWS + EKS · Active-active · Production
| {
  near: top-center
  style: {
    fill: "#F8FAFC"
    stroke: "#E5E7EB"
    border-radius: 10
    font-color: "#111827"
  }
}


