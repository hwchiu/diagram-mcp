{
  "tool": "create_authorization_matrix",
  "input": {
    "title": "Insight Platform 權限總表",
    "subtitle": "10 roles × 8 resources — RBAC with ABAC conditions",
    "roles": [
      { "id": "guest", "label": "Guest", "description": "未登入訪客" },
      { "id": "viewer", "label": "Viewer", "description": "一般員工" },
      { "id": "analyst", "label": "Analyst", "description": "BI 分析師" },
      { "id": "ds", "label": "Data Scientist" },
      { "id": "de", "label": "Data Engineer" },
      { "id": "owner", "label": "Data Owner", "description": "資料擁有者" },
      { "id": "sec", "label": "Security Officer" },
      { "id": "auditor", "label": "Auditor 稽核" },
      { "id": "support", "label": "Support 客服" },
      { "id": "admin", "label": "Platform Admin" }
    ],
    "actions": ["read", "write", "delete", "share"],
    "resources": [
      { "id": "dash", "label": "Dashboards" },
      { "id": "report", "label": "Reports 報表" },
      { "id": "dataset", "label": "Datasets 資料集" },
      { "id": "pii", "label": "PII 欄位", "actions": ["read", "unmask"] },
      { "id": "pipeline", "label": "Pipelines", "actions": ["read", "run", "edit"] },
      { "id": "model", "label": "ML Models", "actions": ["read", "train", "deploy"] },
      { "id": "user", "label": "Users & Roles", "actions": ["read", "invite", "assign"] },
      { "id": "audit", "label": "Audit Log", "actions": ["read", "export"] }
    ],
    "default": "deny",
    "permissions": [
      { "role": "guest", "resource": "dash", "actions": ["read"], "effect": "conditional", "condition": "只限標記為 public 的儀表板" },
      { "role": "viewer", "resource": "dash", "actions": ["read"], "effect": "allow" },
      { "role": "viewer", "resource": "report", "actions": ["read"], "effect": "allow" },
      { "role": "analyst", "resource": "dash", "effect": "allow" },
      { "role": "analyst", "resource": "report", "effect": "allow" },
      { "role": "analyst", "resource": "report", "actions": ["delete"], "effect": "conditional", "condition": "僅限自己建立的項目" },
      { "role": "analyst", "resource": "dataset", "actions": ["read"], "effect": "allow" },
      { "role": "analyst", "resource": "pii", "actions": ["read"], "effect": "conditional", "condition": "欄位自動遮罩 (masked)" },
      { "role": "ds", "resource": "dash", "actions": ["read"], "effect": "allow" },
      { "role": "ds", "resource": "dataset", "actions": ["read", "write"], "effect": "allow" },
      { "role": "ds", "resource": "pii", "actions": ["read"], "effect": "conditional", "condition": "欄位自動遮罩 (masked)" },
      { "role": "ds", "resource": "model", "effect": "allow" },
      { "role": "ds", "resource": "model", "actions": ["deploy"], "effect": "conditional", "condition": "需通過 model review 並由 Data Owner 核准" },
      { "role": "ds", "resource": "pipeline", "actions": ["read", "run"], "effect": "allow" },
      { "role": "de", "resource": "dataset", "effect": "allow" },
      { "role": "de", "resource": "dataset", "actions": ["share"], "effect": "deny" },
      { "role": "de", "resource": "pipeline", "effect": "allow" },
      { "role": "de", "resource": "model", "actions": ["read"], "effect": "allow" },
      { "role": "owner", "resource": "dash", "effect": "allow" },
      { "role": "owner", "resource": "report", "effect": "allow" },
      { "role": "owner", "resource": "dataset", "effect": "allow" },
      { "role": "owner", "resource": "pii", "effect": "conditional", "condition": "僅限自己負責的資料域，且留存存取紀錄" },
      { "role": "owner", "resource": "pipeline", "actions": ["read"], "effect": "allow" },
      { "role": "owner", "resource": "model", "actions": ["read", "deploy"], "effect": "allow" },
      { "role": "sec", "resource": "*", "actions": ["read"], "effect": "allow" },
      { "role": "sec", "resource": "pii", "actions": ["unmask"], "effect": "conditional", "condition": "需事件單號 (incident ticket)，有效 24 小時" },
      { "role": "sec", "resource": "user", "effect": "allow" },
      { "role": "sec", "resource": "audit", "effect": "allow" },
      { "role": "auditor", "resource": "audit", "effect": "allow" },
      { "role": "auditor", "resource": "report", "actions": ["read"], "effect": "allow" },
      { "role": "auditor", "resource": "user", "actions": ["read"], "effect": "allow" },
      { "role": "support", "resource": "dash", "actions": ["read"], "effect": "allow" },
      { "role": "support", "resource": "user", "actions": ["read", "invite"], "effect": "allow" },
      { "role": "support", "resource": "pii", "actions": ["read"], "effect": "conditional", "condition": "欄位自動遮罩 (masked)" },
      { "role": "admin", "resource": "*", "effect": "allow" },
      { "role": "admin", "resource": "pii", "actions": ["unmask"], "effect": "deny" },
      { "role": "admin", "resource": "audit", "actions": ["export"], "effect": "conditional", "condition": "雙人覆核 (four-eyes)" }
    ]
  }
}
