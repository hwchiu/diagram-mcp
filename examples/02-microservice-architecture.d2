vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 64
  }
  ink: "#0F172A"
  muted: "#64748B"
  accent: "#2563EB"
  canvas: "#F7F8FA"
  card: "#FFFFFF"
  border: "#CBD5E1"
}

# Canvas fill via a full-bleed background shape is handled in post-process.
direction: right


title: |md
  # Event-Driven Order Platform
  15+ services · Kafka backbone · CQRS
| {
  near: top-center
  style: {
    fill: "#FFFFFF"
    stroke: "#CBD5E1"
    border-radius: 10
    font-color: "#0F172A"
  }
}


board: " " {
  grid-columns: 3
  grid-gap: 56
  style: {
    fill: "transparent"
    stroke: "transparent"
    font-size: 8
    font-color: "transparent"
  }
  edge: "Edge" {
    grid-columns: 3
    style: {
      fill: "#EEF2FF"
      stroke: "#6366F1"
      stroke-width: 2
      border-radius: 12
      font-size: 15
      bold: true
      font-color: "#0F172A"
    }
    web: "Web App\nNext.js" {
      shape: rectangle
      icon: "/Users/hwchiu/hwchiu/diagram-mcp/assets/icons/nextjs.svg"
      style: {
        fill: "#F8FAFC"
        stroke: "#94A3B8"
        stroke-width: 2
        border-radius: 8
        shadow: true
        font-size: 14
        font-color: "#0F172A"
