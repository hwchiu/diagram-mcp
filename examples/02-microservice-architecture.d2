vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 0
    pad: 64
  }
  ink: "#0F172A"
  muted: "#64748B"
  accent: "#2563EB"
  canvas: "#F7F8FA"
  card: "#FFFFFF"
  border: "#CBD5E1"
}

# Canvas fill via a full-bleed background shape is handled in post-process.
direction: right


title: |md
  # Guidance for Event-Driven Orders
  Edge · BFF · Core · Ops · Data · sparse main flows
| {
  near: top-left
  style: {
    fill: "transparent"
    stroke: "transparent"
    font-color: "#111827"
  }
}


