board.clients -> board.edge: "1" {
  style: {
    stroke: "#1F2937"
    stroke-width: 2
  }
}
board.edge -> board.bff: "2" {
  style: {
    stroke: "#1F2937"
    stroke-width: 2
  }
}
board.bff.cells.apigw -> board.bff.cells.auth: "JWT" {
  style: {
    stroke: "#1F2937"
    stroke-width: 2
  }
}
board.bff -> board.core: "3" {
  style: {
    stroke: "#1F2937"
    stroke-width: 2
  }
}
board.core.cells.orders -> board.core.cells.inventory {
  style: {
    stroke: "#1F2937"
    stroke-width: 2
  }
}
board.core.cells.orders -> board.core.cells.payments: "4" {
  style: {
    stroke: "#1F2937"
    stroke-width: 2
  }
}
board.core.cells.payments -> board.ext.cells.stripe: "5" {
  style: {
    stroke: "#1F2937"
    stroke-width: 2
  }
}
board.core -> board.data: "6" {
  style: {
    stroke: "#059669"
    stroke-width: 2
  }
}
board.core.cells.orders -> board.data.cells.kafka: "7" {
  style: {
    stroke: "#7C3AED"
    stroke-dash: 4
    stroke-width: 2
  }
}
board.data.cells.kafka -> board.ops {
  style: {
    stroke: "#7C3AED"
    stroke-dash: 4
    stroke-width: 2
  }
}
board.ops.cells.notify -> board.ext.cells.ses {
  style: {
    stroke: "#1F2937"
    stroke-width: 2
  }
}




