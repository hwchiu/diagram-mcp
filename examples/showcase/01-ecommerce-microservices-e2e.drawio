        <mxCell id="steptext-10" value="&lt;b style=&quot;font-family:JetBrains Mono;font-size:12.5px;color:#e2e8f0&quot;&gt;Clients → Edge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Inter;font-size:12px;color:#94a3b8&quot;&gt;Web, mobile and admin traffic enters through CDN, WAF and the L7 load balancer.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontColor=#e2e8f0;" vertex="1" parent="1"><mxGeometry x="96" y="787" width="480.8" height="71" as="geometry"/></mxCell>
