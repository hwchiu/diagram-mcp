guide: "Architecture steps" {
  near: center-right
  grid-rows: 3
  grid-gap: 10
  style: {
    fill: "#F8FAFC"
    stroke: "#E5E7EB"
    border-radius: 8
    font-size: 14
    bold: true
    font-color: "#111827"
  }
  row_1: " " {
    grid-columns: 2
    grid-gap: 10
    style: {
      fill: "transparent"
      stroke: "transparent"
      font-size: 8
      font-color: "transparent"
    }
    n1: "1" {
      shape: circle
      width: 28
      height: 28
      style: {
        fill: "#111827"
        stroke: "#111827"
        font-color: "#FFFFFF"
        font-size: 12
        bold: true
      }
    }
    t1: "Owned stores\nEach service writes only its database" {
      width: 260
      height: 52
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-size: 12
        font-color: "#111827"
      }
    }
  }
  row_2: " " {
    grid-columns: 2
    grid-gap: 10
    style: {
