vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 0
    pad: 64
  }
  ink: "#111827"
  muted: "#6B7280"
  accent: "#1D4ED8"
  canvas: "#FFFFFF"
  card: "#FFFFFF"
  border: "#E5E7EB"
}

# Canvas fill via a full-bleed background shape is handled in post-process.
direction: right


title: |md
  # E-Commerce — Data Ownership & Kafka Events
  Service → store ownership · topic producers / consumers
| {
  near: top-left
  style: {
    fill: "transparent"
    stroke: "transparent"
    font-color: "#111827"
  }
}


