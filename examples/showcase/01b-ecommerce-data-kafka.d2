    style: {
      fill: "transparent"
      stroke: "transparent"
      font-size: 8
      font-color: "transparent"
    }
    n3: "3" {
      shape: circle
      width: 28
      height: 28
      style: {
        fill: "#111827"
        stroke: "#111827"
        font-color: "#FFFFFF"
        font-size: 12
        bold: true
      }
    }
    t3: "Consume & react\nShipping, Notify, Search, Recommend subscribe" {
      width: 260
      height: 52
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-size: 12
        font-color: "#111827"
