        <mxCell id="steptext-6" value="&lt;b style=&quot;font-family:JetBrains Mono;font-size:12.5px;color:#e2e8f0&quot;&gt;Owned stores&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Inter;font-size:12px;color:#94a3b8&quot;&gt;Each service is the only writer of its database; no shared tables.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontColor=#e2e8f0;" vertex="1" parent="1"><mxGeometry x="1226" y="171" width="266" height="66" as="geometry"/></mxCell>
