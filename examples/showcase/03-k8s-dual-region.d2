vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 0
    pad: 64
  }
  ink: "#111827"
  muted: "#6B7280"
  accent: "#1D4ED8"
  canvas: "#FFFFFF"
  card: "#FFFFFF"
  border: "#E5E7EB"
}

# Canvas fill via a full-bleed background shape is handled in post-process.
direction: right


title: |md
  # Guidance for Dual-Region Kubernetes
  Global edge · us-east-1 primary · us-west-2 standby · observability
| {
  near: top-left
  style: {
    fill: "transparent"
    stroke: "transparent"
    font-color: "#111827"
  }
}


clients: "Clients" {
  style: {
    fill: "#F5F3FF"
    stroke: "#7C3AED"
    stroke-dash: 4
    stroke-width: 2
    border-radius: 4
    font-size: 14
    bold: true
    font-color: "#111827"
  }
  cells: " " {
    grid-rows: 2
    style: {
      fill: "transparent"
      stroke: "transparent"
      font-size: 8
      font-color: "transparent"
    }
    users: "Users" {
      shape: person
      width: 140
      height: 110
      style: {
        fill: "#FFFFFF"
        stroke: "#E5E7EB"
        stroke-width: 1
        border-radius: 6
        shadow: false
        font-size: 13
        font-color: "#111827"
      }
    }
    web: "Web / Mobile" {
      shape: rectangle
      icon: "/Users/hwchiu/hwchiu/diagram-mcp/assets/icons/react.svg"
      width: 140
      height: 110
      style: {
        fill: "#FFFFFF"
        stroke: "#E5E7EB"
        stroke-width: 1
        border-radius: 6
        shadow: false
        font-size: 13
        font-color: "#111827"
      }
    }
  }
}

