guide: "Architecture steps" {
  near: center-right
  grid-rows: 7
  grid-gap: 10
  style: {
    fill: "#F8FAFC"
    stroke: "#E5E7EB"
    border-radius: 8
    font-size: 14
    bold: true
    font-color: "#111827"
  }
  row_1: " " {
    grid-columns: 2
    grid-gap: 10
    style: {
      fill: "transparent"
      stroke: "transparent"
      font-size: 8
      font-color: "transparent"
    }
    n1: "1" {
      shape: circle
      width: 28
      height: 28
      style: {
        fill: "#111827"
        stroke: "#111827"
        font-color: "#FFFFFF"
        font-size: 12
        bold: true
      }
    }
    t1: "Clients → global edge\nUsers hit CloudFront / WAF / Route 53" {
      width: 260
      height: 52
      style: {
