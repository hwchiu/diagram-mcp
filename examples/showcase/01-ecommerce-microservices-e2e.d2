      height: 28
      style: {
        fill: "#111827"
        stroke: "#111827"
        font-color: "#FFFFFF"
        font-size: 12
        bold: true
      }
    }
    t2: "Edge to BFF tier\nWAF forwards to API Gateway and BFFs" {
      width: 260
      height: 52
      style: {
        fill: "transparent"
        stroke: "transparent"
        font-size: 12
        font-color: "#111827"
      }
    }
  }
  row_3: " " {
    grid-columns: 2
