vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 64
  }
  ink: "#111827"
  muted: "#6B7280"
  accent: "#1D4ED8"
  canvas: "#FFFFFF"
  card: "#FFFFFF"
  border: "#E5E7EB"
}

# Canvas fill via a full-bleed background shape is handled in post-process.
direction: right


title: |md
  # E-Commerce Platform — End-to-End Architecture
  Clients · Edge · BFFs · Domain services · Data · Kafka · Externals
| {
  near: top-center
  style: {
    fill: "#F8FAFC"
    stroke: "#E5E7EB"
    border-radius: 10
    font-color: "#111827"
  }
}


board: " " {
  grid-columns: 3
  grid-gap: 40
  style: {
    fill: "transparent"
    stroke: "transparent"
    font-size: 8
    font-color: "transparent"
  }
  clients: "Clients" {
    grid-columns: 2
    style: {
      fill: "#F5F3FF"
      stroke: "#7C3AED"
      stroke-width: 2
      border-radius: 12
      font-size: 20
      bold: true
      font-color: "#111827"
    }
    web: "Web SPA\nReact · Next.js" {
      shape: rectangle
      icon: "/Users/hwchiu/hwchiu/diagram-mcp/assets/icons/react.svg"
      style: {
        fill: "#F9FAFB"
        stroke: "#9CA3AF"
        stroke-width: 2
        border-radius: 8
        shadow: true
        font-size: 22
        font-color: "#111827"
      }
    }
    mobile: "Mobile App\niOS / Android" {
      shape: person
      style: {
        fill: "#F9FAFB"
        stroke: "#9CA3AF"
        stroke-width: 2
        border-radius: 8
        shadow: true
        font-size: 22
