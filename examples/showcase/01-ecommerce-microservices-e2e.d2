        fill: "#111827"
        stroke: "#111827"
        font-color: "#FFFFFF"
        font-size: 12
        bold: true
      }
    }
    t3: "BFF calls App Tier\nBFFs aggregate domain services over gRPC / HTTP" {
      width: 260
      height: 52
      style: {
