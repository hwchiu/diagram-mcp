  "themeCSS": "\n      svg, text, tspan, .actor, .actor-man, .messageText, .noteText, .labelText, .loopText {\n        font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif !important;\n      }\n      .actor { stroke-width: 1.75px !important; fill: #FFF7ED !important; stroke: #F97316 !important; }\n      .actor-line { stroke: #CBD5E1 !important; }\n      .messageLine0, .messageLine1 { stroke: #334155 !important; }\n      .messageText { font-size: 15px !important; fill: #0F172A !important; }\n      .note { fill: #EDE9FE !important; stroke: #8B5CF6 !important; }\n      .activation0, .activation1, .activation2 {\n        fill: #DBEAFE !important;\n        stroke: #3B82F6 !important;\n      }\n    ",
  "flowchart": {
    "curve": "basis",
    "padding": 28,
    "nodeSpacing": 55,
    "rankSpacing": 65,
    "htmlLabels": false,
    "useMaxWidth": false
  },
  "sequence": {
    "actorMargin": 36,
    "messageMargin": 44,
    "mirrorActors": false,
    "bottomMarginAdj": 18,
    "rightAngles": true,
    "showSequenceNumbers": true,
    "actorFontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "actorFontSize": 15,
    "noteFontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "messageFontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
