        <mxCell id="steptext-8" value="&lt;b style=&quot;font-family:JetBrains Mono;font-size:12.5px;color:#e2e8f0&quot;&gt;Edge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Inter;font-size:12px;color:#94a3b8&quot;&gt;CloudFront serves the SPA from S3 and forwards /api/* through WAF.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontColor=#e2e8f0;" vertex="1" parent="1"><mxGeometry x="96" y="787" width="459" height="71" as="geometry"/></mxCell>
